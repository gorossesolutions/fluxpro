# Supabase project URL, e.g. https://xxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key — safe to expose in the client bundle, RLS enforces access control
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (Edge Function secrets / GitHub Actions secrets, never in the client) ---
# Set these with `supabase secrets set NAME=value`, not in this file.
#   SUPABASE_SERVICE_ROLE_KEY   service-role key, used by scripts/migrate-v1.ts and CI keepalive
#   EXCHANGERATE_API_KEY        exchangerate-api.com key, used by the fx-snapshot Edge Function
#   BOM_FX_SOURCE_URL           Bank of Mauritius indicative-rate endpoint, optional fallback source
